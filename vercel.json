{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    {"source": "/api/index", "destination": "/api/index"},
    {"source": "/api/:admroute*/", "destination": "/api/index?__p=:admroute*"},
    {"source": "/api/:admroute*", "destination": "/api/index?__p=:admroute*"},
    {"source": "/cc-handoff", "destination": "/api/index?__p=cc-handoff"}
  ],
  "functions": {"api/index.mjs": {"maxDuration": 60}},
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; frame-src https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'"}
    ]}
  ]
}
